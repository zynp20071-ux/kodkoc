# KodKoç ayarları - ÖRNEK DOSYA
# Yerelde: Bu dosyanın adını ".env" yap ve değerleri doldur (ya da hiç dokunma, KodKoç kendisi sorar).
# Canlıda: Bu değerleri sunucunun "Environment Variables" bölümüne gir. .env dosyasını ASLA yükleme.

# Google AI Studio'dan alınan Gemini API anahtarı
GEMINI_API_KEY=

# Oturum çerezini imzalayan gizli anahtar. Üretmek için:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# --- Sadece canlı sunucu için ---
# 1 yazılınca canlı mod açılır (anahtar siteden girilemez, çerez sadece HTTPS'te gider)
KODKOC_CANLI=1

# Öğretmen hesabı açmak için gereken davet kodu (boşsa canlıda öğretmen kaydı kapalı)
OGRETMEN_KODU=

# Bir kullanıcının günde yapay zekâya gönderebileceği en fazla istek (varsayılan 40)
GUNLUK_YZ_SINIRI=40

# Bütün sitenin günde yapay zekâya gönderebileceği en fazla istek (0 = sınır yok).
# Çok hesap açarak kişi başı sınırı aşmayı engeller. Gemini anahtarının günlük kotasının altında tut.
GUNLUK_TOPLAM_YZ_SINIRI=400

# PostgreSQL adresi. Verilirse SQLite yerine PostgreSQL kullanılır.
# Ör. postgresql://kullanici:sifre@sunucu-adresi/veritabani_adi
DATABASE_URL=

# SQLite kullanılıyorsa dosyanın yeri (boşsa proje klasöründeki kodkoc.db). Ör. /var/data/kodkoc.db
VERITABANI_YOLU=

# İsteğe bağlı: GitHub saatlik istek sınırını 60'tan 5000'e çıkarır
GITHUB_TOKEN=

# Saat dilimi (sunucular genelde UTC çalışır)
TZ=Europe/Istanbul
# İsteğe bağlı: "Şifremi unuttum" e-postası için SMTP ayarları. SMTP_SUNUCU boşsa özellik kapalıdır
# (öğrenciler şifrelerini yine öğretmenden sıfırlatır). Ör. Gmail için uygulama şifresi gerekir.
SMTP_SUNUCU=
SMTP_PORT=587
SMTP_KULLANICI=
SMTP_SIFRE=
SMTP_GONDEREN=
